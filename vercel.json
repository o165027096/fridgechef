{
  "version": 2,
  "builds": [
    { "src": "public/index.html", "use": "@vercel/static" },
    { "src": "api/recipes.js", "use": "@vercel/node" },
    { "src": "api/scan.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/recipes", "dest": "/api/recipes.js" },
    { "src": "/api/scan", "dest": "/api/scan.js" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ],
  "functions": {
    "api/recipes.js": { "maxDuration": 60 },
    "api/scan.js": { "maxDuration": 30 }
  }
}
